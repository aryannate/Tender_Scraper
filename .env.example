# Copy to .env beside daily_job.py. Real environment variables override .env.
# Keep .env private (chmod 600 .env on Linux); never commit it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# Use ssl + port 465 for implicit TLS. none is only for a trusted local relay.
# Both user/password may be empty for an unauthenticated relay; otherwise set both.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tender-radar@example.com
# Comma-separated recipients:
EMAIL_TO=you@example.com,colleague@example.com

# Optional: one keyword per line; blank uses KEYWORDS in keywords.py.
KEYWORDS_FILE=
# Optional: use persistent paths. Defaults are outputs/daily inside this checkout.
TENDER_OUTPUT_DIR=
TENDER_STATE_DB=
# Optional browser location; install and run with the same value if overriding it.
PLAYWRIGHT_BROWSERS_PATH=
